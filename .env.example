# =============================================================================
# Urator Dashboard — Frontend environment template
# Copy to .env.local and fill in the values you need.
# =============================================================================

# Backend API base URL (tg-manager). Defaults to http://127.0.0.1:8080 when unset.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# Midtrans Snap client key (public checkout page).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# "sandbox" or "production" — selects the Midtrans Snap script + API host.
NEXT_PUBLIC_MIDTRANS_ENV=sandbox

# Build flags
# Set to "true" for Docker / self-hosting (enables Next.js standalone output).
BUILD_STANDALONE=
# Override the build output directory (e.g. .next-build-verify for CI checks).
NEXT_DIST_DIR=
